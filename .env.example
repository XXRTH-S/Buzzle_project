# ---- Summary: OpenRouter free ----
SUMMARY_PROVIDER=openrouter
SUMMARY_MODEL=openrouter/free
OPENROUTER_API_KEY=
SUMMARY_MAX_TOKENS=4096
SUMMARY_TIMEOUT_SECONDS=180
# Optional legacy provider: set SUMMARY_PROVIDER=anthropic and a compatible SUMMARY_MODEL
ANTHROPIC_API_KEY=

# ---- ASR ----
# scribe | faster_whisper
# ---- Cloud demo preparation (not connected to application code yet) ----
# Keep keys private. Never commit this file or paste keys into chat.
# Existing local settings below remain active; filling these fields alone does not enable Cloud.
#
# Groq Console > API Keys: paste your key after the equals sign.
# Groq adapter is available: set ASR_BACKEND=groq to opt in.
# Demo limit: normalized WAV <= 20 MB and <= 5 minutes. No automatic fallback.
GROQ_API_KEY=
GROQ_ASR_MODEL=whisper-large-v3-turbo
#
# Supabase: project URL (not the dashboard URL) and server-only secret key.
# Pending: Supabase SDK/Auth integration. Never expose the secret key in NEXT_PUBLIC_*.
SUPABASE_URL=
# Publishable client key; not a replacement for the server secret key below.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=buzzle-media
# Create this bucket as PRIVATE. These fields are reserved, not active storage settings.
# For the existing S3 adapter, fill S3_ENDPOINT_URL, S3_BUCKET, S3_REGION,
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY below using Supabase S3 credentials.
# An S3 access key is NOT a Supabase secret/service-role key.
# For Cloud Postgres, later replace DATABASE_URL below with the project's connection URI.
# Use direct/session-mode connections for advisory locks, NOT transaction pooling.
# URL-encode special characters in the database password.
#
# Inngest: environment-specific Event Key and Signing Key.
# Pending: Inngest integration; Redis/RQ below is still the active queue.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
#
# Render/Vercel hosting does not require their management API tokens in this app.
# Set secrets in the hosting dashboard separately; local .env is not uploaded automatically.
# Later set PUBLIC_API_URL below and Vercel's NEXT_PUBLIC_API to the HTTPS API URL.
# compose.preview.yml currently overrides provider keys with blanks and does not load this file.
# Do not paste real keys into compose files. Cloud wiring will be changed separately.

ASR_BACKEND=scribe
ELEVENLABS_API_KEY=
# ใช้เฉพาะ ASR_BACKEND=faster_whisper (ดู docs/hardware.md — เครื่อง 6 GB ใช้ medium)
LOCAL_ASR_MODEL=biodatlab/whisper-th-medium-combined
LOCAL_ASR_COMPUTE=int8
LOCAL_ASR_DEVICE=cuda

# ---- โครงสร้างพื้นฐาน ----
DATABASE_URL=postgresql://postgres:buzzle@db:5432/buzzle
REDIS_URL=redis://redis:6379/0

# ---- ที่เก็บไฟล์ ----
# local | s3
STORAGE_BACKEND=local
MEDIA_DIR=/srv/media
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

PUBLIC_API_URL=http://localhost:8100
